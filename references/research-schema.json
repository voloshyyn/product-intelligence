          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            },
            "uniqueItems": true
          },
          "screenshot_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            },
            "uniqueItems": true
          },
          "date_checked": {
            "type": "string",
            "format": "date"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "maxLength": 12000
          },
          "caveat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "company_statement": {
            "type": "boolean"
          },
          "facet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ],
            "maxLength": 12000
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "billing_period": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "polarity": {
            "enum": [
              "strength",
              "weakness",
              "neutral"
            ]
