        "required": [
          "product_id",
          "name",
          "url",
          "industry",
          "market"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "custom_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": [
          "criterion_id",
          "label",
          "question"
        ],
        "additionalProperties": false
      },
      "minItems": 0
