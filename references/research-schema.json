{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-intelligence.local/research-schema/1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "single",
        "competitor",
        "comparison"
      ]
    },
    "depth": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^\\s]+$"
          },
          "industry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "market": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
