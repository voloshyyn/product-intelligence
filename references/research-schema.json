          "category": {
            "enum": [
              "overview",
              "positioning",
              "audience",
              "needs",
              "features",
              "services",
              "pricing",
              "business",
              "marketing",
              "journeys",
              "usability",
              "design",
              "accessibility",
              "trust",
              "strategy"
